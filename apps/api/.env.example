# Copy to apps/api/.env for local development (npm run dev)

DATABASE_URL=file:./dev.db
# Long random string used to sign login tokens, e.g. `openssl rand -hex 32`
JWT_SECRET=
PORT=3000
# Where uploaded files are stored (default: apps/api/uploads)
# UPLOADS_DIR=uploads
# Uploads are rejected once the folder reaches this size (default: 3 GB)
# UPLOADS_MAX_BYTES=3221225472
