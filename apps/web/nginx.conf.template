# Rendered by the nginx image at startup (envsubst); NGINX_LOCAL_RESOLVERS is
# filled in from the container's DNS so "api" is re-resolved after the API
# container restarts and gets a new IP.
server {
    listen 80;
    server_name _;
    server_tokens off;

    # Sent with every response. The CSP here only covers framing, <base> and
    # plugins; the API adds a stricter sandbox CSP to /uploads.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api api:3000;

    root /usr/share/nginx/html;
    index index.html;

    # Uploads are capped at 10MB by the API
    client_max_body_size 11m;

    # REST API (the /api prefix is stripped)
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Socket.IO (chat + WebRTC signaling)
    location /socket.io/ {
        proxy_pass http://$api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    # User uploaded files
    location /uploads/ {
        proxy_pass http://$api;
        proxy_set_header Host $host;
        # Already added above; avoid sending it twice
        proxy_hide_header X-Content-Type-Options;
    }

    # Vue single page app
    location / {
        try_files $uri $uri/ /index.html;
    }
}
